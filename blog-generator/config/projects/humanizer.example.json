    "allowed_relations": [
      "prerequisite",
      "deeper_explanation",
      "evidence_or_example",
      "next_action"
    ]
  },
  "apis": {
    "history": {
      "url": "https://www.humanizer.help/internal/blogs",
      "method": "GET",
      "auth": {
        "header": "X-Blog-API-Key",
        "secret_env": "HUMANIZER_BLOG_API_KEY"
      },
      "query": {
        "include": "body,links,archived,merged,redirected",
        "limit": 100
      },
      "response_contract": "inventory-v1"
    },
    "publish": {
      "url": "https://www.humanizer.help/internal/publish_blogs",
      "method": "POST",
      "auth": {
        "header": "X-Blog-API-Key",
        "secret_env": "HUMANIZER_BLOG_API_KEY"
      },
      "idempotency_header": "Idempotency-Key",
      "mode": "auto_after_review",
      "payload_contract": "publish-blog-v1"
    }
  },
  "presentation_defaults": {
    "author": "Humanizer.help Editorial Team",
    "author_bio": "The Humanizer.help editorial team writes practical AI writing guides for students, ESL writers, and academic drafts that need clearer, more natural English.",
    "avatar_seed": "humanizer-help-editorial",
    "tag": "AI Writing",
    "read_time": "6 min read",
    "image_policy": {
      "mode": "search_per_article",
      "preferred_sources": ["pexels"],
      "preferred_moods": ["healing", "study", "coffee", "scenery", "daily life"],
      "orientation": "landscape",
      "require_unique_url": true,
      "fallback": "block_publish"
    }
